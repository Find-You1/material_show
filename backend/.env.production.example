# 生产环境变量模板（阿里云 ECS / Linux）。
#
# 用法：在服务器上把本文件复制成 .env，然后替换所有 <...> 占位符：
#     cp backend/.env.production.example backend/.env
#     vim backend/.env
#
# 与 .env.example（本地开发用）的关键差别：
#   DEBUG=false          关闭调试模式与详细日志，别把堆栈暴露到公网
#   SECRET_KEY           必须重新生成；沿用开发环境的值等于把 token 签名密钥公开
#   CORS_ORIGINS         改成公网地址
#   LOCAL_STORAGE_ROOT   指向数据盘，别留在项目目录里（重新部署会连带清掉）

# ---- 应用 ----
APP_NAME=MaterialShow
DEBUG=false
# 生成：python3 -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=<替换为随机串>
ACCESS_TOKEN_EXPIRE_DAYS=7
# 前后端同源（Nginx 把 /api、/media 反代到本机 8010），浏览器不会发跨域请求；
# 这里填公网地址只是为了让 Postman 这类外挂客户端能直连调试。
CORS_ORIGINS=http://47.112.184.71

# ---- 数据库 ----
# 密码不要沿用 init_db.sql 里的开发口令，先改脚本再建号
DATABASE_URL=mysql+pymysql://ms_app:<数据库密码>@127.0.0.1:3306/material_show?charset=utf8mb4

# ---- 存储 ----
# local：图片落本地盘，由 /media 路由直接发文件。生产默认，零依赖零费用。
# s3   ：切到对象存储（阿里云 OSS / 自建 MinIO）时改 s3 并把下面几项填上。
#
# 本机（ecs.e-c1m1.large）只有 40 GiB 系统盘、没有独立数据盘，所以存储目录直接放
# 在系统盘上。代价是：重置系统盘 / 换实例会连图片一起丢，重要素材记得另外备份。
# 部署脚本会自动 mkdir 并把属主改成服务用户，不用手工建。
STORAGE_BACKEND=local
LOCAL_STORAGE_ROOT=/data/material-show/storage
MEDIA_URL_PREFIX=/media

# 仅 STORAGE_BACKEND=s3 时需要；用 local 时这几行留着不影响。
# 地域跟着 ECS 走（本实例是华南1 深圳，可用区 D），跨地域访问 OSS 会走公网、慢且计流量费。
S3_ENDPOINT=https://oss-cn-shenzhen.aliyuncs.com
S3_REGION=cn-shenzhen
S3_BUCKET=<Bucket 名>
S3_ACCESS_KEY=<RAM AccessKeyId>
S3_SECRET_KEY=<RAM AccessKeySecret>
# 公开读的固定域名：OSS 填 https://<bucket>.<endpoint>，MinIO 填 http://<IP>:9000。
# 留空则退回预签名 URL（瀑布流场景下会造成图片缓存整体失效，不推荐）。
S3_PUBLIC_BASE_URL=
S3_PRESIGN_EXPIRE=3600

# ---- 图片处理 ----
MAX_UPLOAD_MB=20
# 图片处理线程数。2 核 2 GiB 的机器设 1：Pillow 解一张大图就要几百 MB，
# 开到 2 会和 MySQL、接口一起抢内存，触发 OOM Killer 把 uvicorn 直接干掉。
# 升配到 4 GiB 以上再考虑调到 2。
IMAGE_WORKERS=1
# 单图像素上限（80MP）。大图解码内存与像素数成正比，2 GiB 的机器建议压到 40000000。
MAX_IMAGE_PIXELS=80000000

# ---- 种子数据（只有 python -m app.db.seed 会读）----
# 注意：seed.py 用的是 os.getenv，pydantic 读 .env 不会写进 os.environ，
# 写在这里是无效的。第一次建管理员账号要这样跑：
#   cd backend && SEED_ADMIN_PASSWORD='强密码' .venv/bin/python -m app.db.seed
# 不改的话会落到 seed.py 里的默认弱口令 Admin@123456。
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=