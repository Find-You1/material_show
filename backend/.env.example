# ---- 应用 ----
APP_NAME=MaterialShow
DEBUG=true
# 必填，无默认值。生成方式：python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# ---- 数据库 ----
DATABASE_URL=mysql+pymysql://ms_app:CHANGE_ME@127.0.0.1:3306/material_show?charset=utf8mb4

# ---- 存储 ----
# local | s3
STORAGE_BACKEND=local
LOCAL_STORAGE_ROOT=./storage
MEDIA_URL_PREFIX=/media

S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=material-show
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
# 配了就用公开读 + 固定域名（推荐，避免预签名 URL 破坏浏览器缓存）
# 留空则退回预签名 URL
S3_PUBLIC_BASE_URL=
S3_PRESIGN_EXPIRE=3600

# ---- 图片处理 ----
MAX_UPLOAD_MB=20
IMAGE_WORKERS=2
MAX_IMAGE_PIXELS=80000000